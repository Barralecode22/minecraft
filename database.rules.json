{
  "rules": {
    "rooms": {
      "$room": {
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid == $uid",
            "$tab": {
              ".validate": "newData.hasChildren(['kind', 'presence'])",
              "kind": {
                ".validate": "newData.val() == 'viewer'"
              },
              "presence": {
                ".validate": "newData.hasChildren(['nm'])",
                "nm": {
                  ".validate": "newData.isString() && newData.val().length <= 16"
                },
                "p": {
                  ".validate": "newData.isString() && newData.val().length <= 100"
                },
                "an": {
                  ".validate": "newData.isString() && newData.val().length <= 6000"
                },
                "e": {
                  ".validate": "newData.isString() && newData.val().length <= 6000"
                },
                "eq": {
                  ".validate": "newData.isNumber()"
                },
                "w": {
                  ".validate": "newData.isNumber()"
                },
                "s": {
                  ".validate": "newData.isNumber()"
                },
                "k": {
                  ".validate": "newData.isNumber()"
                },
                "hg": {
                  ".validate": "newData.isString() && newData.val().length <= 100"
                }
              }
            }
          }
        }
      }
    }
  }
}
